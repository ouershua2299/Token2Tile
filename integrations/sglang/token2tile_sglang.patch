+        # relying on a per-duration config constant.
+        try:
+            from sglang.multimodal_gen.runtime.managers.forward_context import (
+                get_forward_context as _t2t_gfc,
+            )
+
+            _fc = _t2t_gfc()
+            _img_cpu = img_pos.detach().to("cpu")
+            _audio_cpu = audio_pos.detach().to("cpu")
+            # Generated-video rows after the last audio row.  For fl2va the
+            # keyframe condition rows sit between text and audio, so the
+            # target video is this contiguous tail, not the whole img_pos.
+            _tail_from = int(_audio_cpu.max()) + 1 if _audio_cpu.numel() else 0
+            _fc.minimax_h3_layout = {
+                "video_tail": int((_img_cpu >= _tail_from).sum()),
+                "video": int(_img_cpu.numel()),
+                "video_start": int(_img_cpu.min()) if _img_cpu.numel() else -1,
+                "video_stop": int(_img_cpu.max()) + 1 if _img_cpu.numel() else -1,
+                "audio": int(audio_pos.numel()),
+                "text_rows": int(text_pos.numel()),
+            }
+        except AssertionError:
+            pass  # no forward context (direct model callers)
